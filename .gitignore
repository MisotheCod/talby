# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# temp scripts
*.cjs
# ...but keep the real, version-controlled harnesses/seeders
!e2e/run-parity.cjs
!e2e/shoot-baseline.cjs
!tools/talby-parity.cjs
!scripts/seed-design-fixture.cjs
!scripts/drawer-save-regression.cjs

# local desktop attachments
.hermes/
e2e/talby-parity/

# production backups contain database secrets — never commit
backups/*.json
